# Kitevo — copy to .env.local and fill in. Production values go in Vercel, never here.
# Next.js loads .env then .env.local; .env.local OVERRIDES .env for the same keys.
#
# Production setup is DEPLOY.md. Some of these are guarded: scripts/vercel-build.cjs fails
# a production build on a bad NEXT_PUBLIC_APP_URL, RESEND_FROM_EMAIL, or a DATABASE_URL
# without DIRECT_URL — each falls back to something that looks fine and is silently broken.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase gives three connection strings and Prisma needs two of them. Neither is the one
# labelled "direct connection" — that is IPv6-only without the paid IPv4 add-on, so
# Vercel's builder cannot reach it.
#
# Locally, prefer a DEDICATED dev database (a separate Supabase project, or Docker
# Postgres) so migration authoring (`prisma migrate dev`) can never touch real
# user data by accident.
#
# DATABASE_URL: transaction pooler, port 6543. Used at runtime. ?pgbouncer=true is
# required — transaction mode has no prepared statements, and Prisma uses them by default.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: session pooler, port 5432. Migrations run through this
# (`prisma migrate dev` locally; `prisma migrate deploy` on deploy — GitHub Action
# .github/workflows/db-migrate.yml and scripts/vercel-build.cjs). Schema-mutating
# commands run inside a transaction, which the transaction pooler cannot do.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth (NextAuth) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (use a DIFFERENT value in production)
NEXTAUTH_SECRET=your-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# ── App ──────────────────────────────────────────────────────────────────────
# No trailing slash: OAuth redirect URIs are built as `${NEXT_PUBLIC_APP_URL}/api/...`,
# so a trailing slash doubles the separator and stops matching Google/Meta.
# Production: https://getkitevo.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payments ─────────────────────────────────────────────────────────────────
# "stripe" (default) or "dodo". config/subscriptions.ts reads this too, to pick between
# STRIPE_PRICE_ID_* and DODO_PRODUCT_ID_*, so the plan ids always match the provider.
# An unrecognised value throws at startup rather than silently falling back — billing
# through the wrong account is worse than not booting.
PAYMENT_PROVIDER=stripe

# ── Stripe (when PAYMENT_PROVIDER=stripe) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Dodo Payments (when PAYMENT_PROVIDER=dodo) ───────────────────────────────
# Merchant of Record: Dodo bills the customer, handles global sales tax and pays out, so
# no US entity or per-jurisdiction tax registration is needed.
# Defaults to test_mode; only "live_mode" takes real money.
DODO_API_KEY=
DODO_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=

# Dodo calls them products, not prices. Same tier/interval naming as the Stripe ids below.
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_STARTER_YEARLY=
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_PRO_YEARLY=
DODO_PRODUCT_ID_BRAND=
DODO_PRODUCT_ID_BRAND_YEARLY=

# Signs the Stripe customer id cookie. openssl rand -base64 32
SUBSCRIPTION_COOKIE_SECRET=your-random-secret-at-least-32-chars

# Read dynamically as <PREFIX>_<TIER_ID_UPPER>[_YEARLY] (config/subscriptions.ts), where
# the prefix follows PAYMENT_PROVIDER.
# Every tier with a `priceYearly` in config needs a *_YEARLY id too, or its yearly
# checkout 500s. A missing one fails at checkout, not at build.
STRIPE_PRICE_ID_STARTER=price_...          # Starter: $9/mo, 1 kit (creator)
STRIPE_PRICE_ID_STARTER_YEARLY=price_...   # Starter yearly: $84/yr ($7/mo)
STRIPE_PRICE_ID_PRO=price_...              # Pro: $15/mo, 3 kits (creator)
STRIPE_PRICE_ID_PRO_YEARLY=price_...       # Pro yearly: $144/yr ($12/mo)
STRIPE_PRICE_ID_BRAND=price_...            # Brand Pro: $29/mo, grants brand_verified badge
STRIPE_PRICE_ID_BRAND_YEARLY=price_...     # Brand Pro yearly: $290/yr

# ── Beta auto-comp (optional) ────────────────────────────────────────────────
# While set to a tier id, every NEW signup is auto-granted that tier's entitlements free
# (beta testers get Pro without checkout). Unset at launch so new signups return to normal.
# Existing users are untouched. scripts/comp-user.ts grants/revokes individuals by hand.
# vercel-build.cjs prints a reminder if this is left on in production.
BETA_AUTO_COMP_TIER=

# Pro free trial length in days (lib/trials.ts). Unset = 14, 0 = trials off, max 30.
# One per account (first checkout ever), verified email, creators only; card collected at
# checkout and billed when the trial ends. Discount codes are created in the payment
# provider's dashboard (limits live there); /pricing?code=XYZ pre-applies one.
PRO_TRIAL_DAYS=

# ── Custom domains (lib/custom-domains.ts) ──────────────────────────────────
# Creators' domains are added to this Vercel project via the Vercel API, which also issues
# their certificates. Without these two, the feature shows "not switched on yet".
# Token: Vercel → Account Settings → Tokens (scope: the account/team that owns the project).
# Project id: Vercel → Project → Settings → General → Project ID. Team id only for team accounts.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Extra hosts that are Kitevo itself (comma-separated), e.g. a staging domain. The app URL,
# its www twin, localhost and *.vercel.app are always treated as Kitevo, never as a custom domain.
APP_HOSTS=

# ── Platform token encryption (lib/token-crypto.ts) ─────────────────────────
# Encrypts Instagram/YouTube OAuth tokens at rest (AES-256-GCM). "<id>:<base64 32 bytes>",
# comma-separated; the FIRST key encrypts, all keys decrypt (rotation: prepend a new key,
# run scripts/encrypt-platform-tokens.ts, then drop the old one). Unset = plaintext + warning.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=

# ── Meta (Facebook) — Instagram Graph API ────────────────────────────────────
# Scopes requested: business_management, instagram_basic, pages_show_list,
# instagram_manage_insights. All of them require App Review + Business Verification
# before anyone other than an app admin/tester can connect an account.
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret

# ── Google OAuth — SSO + YouTube ─────────────────────────────────────────────
# youtube.readonly is a SENSITIVE scope: until OAuth verification passes, users see an
# "unverified app" warning and you are capped at 100 of them.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Google Search Console ────────────────────────────────────────────────────
# Ownership proof for the domain, required before Google's OAuth branding
# verification accepts getkitevo.com as our homepage. Not a secret: it ships in the
# page HTML. Get it from Search Console -> Add property -> URL prefix -> HTML tag.
GOOGLE_SITE_VERIFICATION=

# ── Google Analytics (GA4) ───────────────────────────────────────────────────
# Measurement ID (G-XXXXXXXXXX). GA loads only when this is set (app/layout.tsx),
# so set it in PRODUCTION only — leaving it unset locally/on preview keeps dev
# traffic out of the analytics data. Not a secret: it ships in the page HTML.
NEXT_PUBLIC_GA_ID=

# ── Resend — transactional email ─────────────────────────────────────────────
RESEND_API_KEY=re_...

# Must be an address on a Resend-VERIFIED domain or every send is rejected. Production
# sends from the mail. subdomain deliberately: transactional bounces and spam complaints
# then hit that subdomain's reputation rather than the root domain's.
# The "Name <address>" form is what makes the From line read "Kitevo".
# Production: Kitevo <hello@mail.getkitevo.com>
RESEND_FROM_EMAIL=Kitevo <noreply@yourdomain.com>

# ── Admin + referral payouts ─────────────────────────────────────────────────
# Comma-separated emails that can open /admin/payouts (everyone else gets a 404) and
# receive the monthly "payouts due" email.
ADMIN_EMAILS=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/payouts-digest.
# Generate: openssl rand -base64 32
CRON_SECRET=
