// Prisma schema — Phase 6 (auth) and beyond (profile, kits, subscription)
// PostgreSQL (Neon, Vercel Postgres, or local Postgres). For local dev use a Postgres URL or Neon branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime: Supabase's transaction pooler (:6543). Serverless functions open a connection
  // per invocation, which exhausts a direct connection fast. Needs ?pgbouncer=true —
  // transaction mode has no prepared statements, and Prisma uses them by default.
  url = env("DATABASE_URL")

  // Migrations (`prisma migrate deploy`, applied on deploy by the GitHub Action and
  // the Vercel build) cannot run through the transaction pooler. Point this at the
  // SESSION pooler (:5432 on the pooler host), not at Supabase's "direct connection"
  // — the direct one is IPv6-only unless you buy the IPv4 add-on, and Vercel's
  // builder will not reach it. The shared pooler is IPv4 on every tier. See
  // DEPLOY.md step 2.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?  // null if OAuth-only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 9: link Stripe customer
  stripeCustomerId String? @unique

  // Phase 7: creator profile (can move to separate table later)
  username  String?  @unique // for /kit/[username] and profile URL
  bio       String?
  avatarUrl String?
  links     String?  // JSON array of { label, url }

  // Phase 10: Instagram (Meta Graph API)
  instagramUserId           String?   // IG Business/Creator account id
  instagramAccessToken      String?   // Long-lived token for API calls
  instagramTokenExpiresAt   DateTime? // When token expires (for refresh prompt)

  // YouTube integration
  youtubeChannelId          String?
  youtubeAccessToken        String?
  youtubeRefreshToken       String?
  youtubeTokenExpiresAt     DateTime?

  // Social platform — account type
  accountType   String  @default("creator") // "creator" | "brand"
  niches        String? // JSON string[] — creator topics / brand interests
  openToCollab  Boolean @default(true)
  location      String?

  // Verification ticks (like X's blue/gold tick)
  // null = no tick, "creator_pro" = blue (Pro subscriber), "top_creator" = gold (manually granted)
  verifiedTier  String?

  // Comped access: grants a tier's entitlements (kits, badge, inquiry) with NO subscription.
  // For beta testers, press, grandfathered users. A tier id ("starter"|"pro"|"brand") or null.
  // Set/cleared with scripts/comp-user.ts. Kept separate from verifiedTier so a comp can be
  // revoked in one place and never gets cleared by subscription syncing. See config resolveVerifiedTier.
  compedTier    String?

  // Cached creator stats for discover filtering (refreshed from IG/YT; see lib/creator-stats-cache.ts)
  followerCount  Int?      // primary audience size (IG followers, else YT subscribers)
  engagementRate Float?    // IG avg engagement %
  statsUpdatedAt DateTime? // when the cache was last refreshed

  // Brand profile (non-null when accountType = "brand")
  brandProfile  BrandProfile?

  // Conversations (social DMs)
  conversationsAsA ConversationParticipant[]
  sentMessages     Message[]

  // Campaigns (Phase 2)
  campaigns            Campaign[]               // brand creates campaigns
  campaignApplications CampaignApplication[]    // creator applies to campaigns

  // Phase 11: Onboarding (redirect new users to /onboarding until they finish)
  onboardingCompletedAt DateTime?

  // Email verification
  emailVerified             Boolean   @default(false)
  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiresAt DateTime?

  // Password reset
  resetPasswordToken          String?   @unique
  resetPasswordTokenExpiresAt DateTime?

  // Account deletion confirmation code (6-digit, expires in 15 min)
  deleteAccountCode           String?
  deleteAccountCodeExpiresAt  DateTime?

  // OAuth accounts (Google etc.)
  accounts Account[]

  // Relations for Phase 8 (kits)
  kits      Kit[]
  analyticsEvents AnalyticsEvent[]

  // Shortlist / save creators (brand saves creators)
  savedCreators SavedCreator[] @relation("BrandSaved")   // as brand: creators I saved
  savedByBrands SavedCreator[] @relation("SavedByBrand") // as creator: brands that saved me
}


model Kit {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String   @unique // globally unique — kit URLs must not clash across users
  name              String
  workSamples       String   // JSON
  rates             String   // JSON
  brands            String   // JSON
  sectionVisibility String   // JSON
  appearance        String   @default("{}") // kit theme JSON: { preset: warm|cool|paper|noir }
  manualStats       String   @default("{}") // JSON: creator-reported stats used when a platform is not connected
  passwordHash      String?  // bcrypt hash; null = public kit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])

  // Phase 12.3: Kit analytics (views)
  views     KitView[]
  inquiries Inquiry[]
}

model KitView {
  id       String   @id @default(cuid())
  kitId    String
  kit      Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  referrer String?

  @@index([kitId])
  @@index([viewedAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  status    String   @default("new") // new | reviewing | negotiating | won | lost

  @@index([kitId])
  @@index([createdAt])
}

// Brand identity (one per brand account)
model BrandProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  industry    String
  budgetRange String  // e.g. "$500–$2k", "$2k–$10k", "$10k+"
  website     String?
  logoUrl     String?
  description String? // brand bio / what they're looking for
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// DM conversations between a brand and a creator (exactly 2 participants)
model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Campaign brief posted by a brand
model Campaign {
  id          String   @id @default(cuid())
  brandId     String
  brand       User     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  description String
  niche       String?  // target creator niche
  budget      String?  // display string e.g. "$500–$2k"
  deadline    DateTime?
  status      String   @default("open") // "open" | "closed" | "draft"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications CampaignApplication[]
  views        CampaignView[]

  @@index([brandId])
  @@index([status, createdAt])
}

model CampaignView {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerId   String?  // logged-in viewer (null for anonymous); owner views are not recorded
  viewedAt   DateTime @default(now())
  referrer   String?

  @@index([campaignId])
  @@index([viewedAt])
}

// Creator's application to a campaign
model CampaignApplication {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  message    String?
  status     String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, creatorId])
  @@index([creatorId])
}

model SavedCreator {
  id        String   @id @default(cuid())
  brandId   String
  brand     User     @relation("BrandSaved", fields: [brandId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation("SavedByBrand", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([brandId, creatorId])
  @@index([brandId])
  @@index([creatorId])
}

// OAuth accounts (Google, etc.) linked to a User
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String  // "google"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// First-party product funnel events (lib/analytics.ts). Names are a closed set
// (ANALYTICS_EVENTS); props is a small JSON object with no PII. dedupeKey makes
// "first time" events (e.g. a kit's first outside view) idempotent.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  props     String?
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}
