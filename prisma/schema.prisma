// Prisma schema — Phase 6 (auth) and beyond (profile, kits, subscription)
// PostgreSQL (Neon, Vercel Postgres, or local Postgres). For local dev use a Postgres URL or Neon branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime: Supabase's transaction pooler (:6543). Serverless functions open a connection
  // per invocation, which exhausts a direct connection fast. Needs ?pgbouncer=true —
  // transaction mode has no prepared statements, and Prisma uses them by default.
  url = env("DATABASE_URL")

  // Migrations (`prisma migrate deploy`, applied on deploy by the GitHub Action and
  // the Vercel build) cannot run through the transaction pooler. Point this at the
  // SESSION pooler (:5432 on the pooler host), not at Supabase's "direct connection"
  // — the direct one is IPv6-only unless you buy the IPv4 add-on, and Vercel's
  // builder will not reach it. The shared pooler is IPv4 on every tier. See
  // DEPLOY.md step 2.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?  // null if OAuth-only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 9: link Stripe customer
  stripeCustomerId String? @unique

  // Phase 7: creator profile (can move to separate table later)
  username  String?  @unique // for /kit/[username] and profile URL
  bio       String?
  avatarUrl String?
  links     String?  // JSON array of { label, url }

  // Phase 10: Instagram (Meta Graph API)
  instagramUserId           String?   // IG Business/Creator account id
  instagramAccessToken      String?   // Long-lived token for API calls
  instagramTokenExpiresAt   DateTime? // When token expires (for refresh prompt)

  // YouTube integration
  youtubeChannelId          String?
  youtubeAccessToken        String?
  youtubeRefreshToken       String?
  youtubeTokenExpiresAt     DateTime?

  // Social platform — account type
  accountType   String  @default("creator") // "creator" | "brand"
  niches        String? // JSON string[] — creator topics / brand interests
  openToCollab  Boolean @default(true)
  location      String?

  // Verification ticks (like X's blue/gold tick)
  // null = no tick, "creator_pro" = blue (Pro subscriber), "top_creator" = gold (manually granted)
  verifiedTier  String?

  // Comped access: grants a tier's entitlements (kits, badge, inquiry) with NO subscription.
  // For beta testers, press, grandfathered users. A tier id ("starter"|"pro"|"brand") or null.
  // Set/cleared with scripts/comp-user.ts. Kept separate from verifiedTier so a comp can be
  // revoked in one place and never gets cleared by subscription syncing. See config resolveVerifiedTier.
  compedTier    String?

  // Cached creator stats for discover filtering (refreshed from IG/YT; see lib/creator-stats-cache.ts)
  followerCount  Int?      // primary audience size (IG followers, else YT subscribers)
  engagementRate Float?    // IG avg engagement %
  statsUpdatedAt DateTime? // when the cache was last refreshed

  // Brand profile (non-null when accountType = "brand")
  brandProfile  BrandProfile?

  // Conversations (social DMs)
  conversationsAsA ConversationParticipant[]
  sentMessages     Message[]

  // Campaigns (Phase 2)
  campaigns            Campaign[]               // brand creates campaigns
  campaignApplications CampaignApplication[]    // creator applies to campaigns

  // Phase 11: Onboarding (redirect new users to /onboarding until they finish)
  onboardingCompletedAt DateTime?

  // Email verification
  emailVerified             Boolean   @default(false)
  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiresAt DateTime?

  // Password reset
  resetPasswordToken          String?   @unique
  resetPasswordTokenExpiresAt DateTime?

  // Account deletion confirmation code (6-digit, expires in 15 min)
  deleteAccountCode           String?
  deleteAccountCodeExpiresAt  DateTime?

  // OAuth accounts (Google etc.)
  accounts Account[]

  // Relations for Phase 8 (kits)
  kits      Kit[]
  customDomains CustomDomain[]
  products      Product[]
  sales         Order[]   @relation("SellerOrders")
  paymentConnections PaymentConnection[]
  schedulerConnections SchedulerConnection[]
  aiConnection         AiConnection?
  blocksMade           UserBlock[]  @relation("BlocksMade")
  blockedBy            UserBlock[]  @relation("BlockedBy")
  inquiryBlocks        InquiryBlock[]
  reportsMade          UserReport[] @relation("ReportsMade")
  reportsAgainst       UserReport[] @relation("ReportsAgainst")
  /// Set by an admin (/admin/reports): no sign-in, public pages and campaigns hidden.
  suspendedAt          DateTime?
  copilotUsage         CopilotUsage[]
  dealsAsCreator Deal[] @relation("CreatorDeals")
  dealsAsBrand   Deal[] @relation("BrandDeals")
  analyticsEvents AnalyticsEvent[]
  // Referral program (lib/referrals.ts)
  referralCode         String?              @unique
  referredById         String?
  referredBy           User?                @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]               @relation("Referrals")
  referredAt           DateTime?
  payoutProfile        PayoutProfile?
  commissionsEarned    ReferralCommission[] @relation("CommissionReferrer")
  commissionsGenerated ReferralCommission[] @relation("CommissionReferred")
  referralPayouts      ReferralPayout[]

  // Shortlist / save creators (brand saves creators)
  savedCreators SavedCreator[] @relation("BrandSaved")   // as brand: creators I saved
  savedByBrands SavedCreator[] @relation("SavedByBrand") // as creator: brands that saved me

  @@index([accountType, createdAt]) // Discover: newest creators
}


model Kit {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String   @unique // globally unique — kit URLs must not clash across users
  name              String
  workSamples       String   // JSON
  rates             String   // JSON
  brands            String   // JSON
  sectionVisibility String   // JSON
  appearance        String   @default("{}") // kit theme JSON: { preset: warm|cool|paper|noir }
  manualStats       String   @default("{}") // JSON: creator-reported stats used when a platform is not connected
  booking           String   @default("{}") // JSON: { url, label } — "Book a call" via the creator's connected scheduler (lib/kit-booking)
  passwordHash      String?  // bcrypt hash; null = public kit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])

  // Phase 12.3: Kit analytics (views)
  views     KitView[]
  inquiries Inquiry[]
  customDomain CustomDomain?
}

/// A creator's own domain pointing at one kit (Starter+). Served via the Vercel project's
/// domain list; see lib/custom-domains.ts.
model CustomDomain {
  id            String    @id @default(cuid())
  hostname      String    @unique // lowercase, punycode, no port/trailing dot
  kitId         String    @unique
  kit           Kit       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apexName      String?   // registrable domain, from Vercel (decides CNAME vs A record)
  status        String    @default("pending") // "pending" | "active"
  verified      Boolean   @default(false) // Vercel ownership check (only needed if the domain is on another Vercel account)
  verification  String    @default("[]") // JSON: TXT records Vercel asks for when not verified
  dnsConfigured Boolean   @default(false) // DNS points at Vercel
  tlsReady      Boolean   @default(false) // HTTPS answered
  lastError     String?
  lastCheckedAt DateTime?
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model KitView {
  id       String   @id @default(cuid())
  kitId    String
  kit      Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  referrer String?

  @@index([kitId])
  @@index([viewedAt])
  @@index([kitId, viewedAt]) // views over a date range per kit (dashboard analytics)
}

model Inquiry {
  id        String   @id @default(cuid())
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  status    String   @default("new") // new | reviewing | negotiating | won | lost

  @@index([kitId])
  @@index([createdAt])
  @@index([kitId, createdAt]) // a kit's inquiries, newest first (Pipeline)
}

// Brand identity (one per brand account)
model BrandProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  industry    String
  budgetRange String  // e.g. "$500–$2k", "$2k–$10k", "$10k+"
  website     String?
  logoUrl     String?
  description String? // brand bio / what they're looking for
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// DM conversations between a brand and a creator (exactly 2 participants)
model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId]) // FK: deleting an account removes its messages
}

// Campaign brief posted by a brand
model Campaign {
  id          String   @id @default(cuid())
  brandId     String
  brand       User     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  description String
  niche       String?  // target creator niche
  budget      String?  // display string e.g. "$500–$2k"
  deadline    DateTime?
  status      String   @default("open") // "open" | "closed" | "draft"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications CampaignApplication[]
  views        CampaignView[]

  @@index([brandId])
  @@index([status, createdAt])
}

model CampaignView {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerId   String?  // logged-in viewer (null for anonymous); owner views are not recorded
  viewedAt   DateTime @default(now())
  referrer   String?

  @@index([campaignId])
  @@index([viewedAt])
  @@index([campaignId, viewedAt]) // campaign analytics over a date range
}

// Creator's application to a campaign
model CampaignApplication {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  message    String?
  status     String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, creatorId])
  @@index([creatorId])
}

model SavedCreator {
  id        String   @id @default(cuid())
  brandId   String
  brand     User     @relation("BrandSaved", fields: [brandId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation("SavedByBrand", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([brandId, creatorId])
  @@index([brandId])
  @@index([creatorId])
}

// OAuth accounts (Google, etc.) linked to a User
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String  // "google"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// First-party product funnel events (lib/analytics.ts). Names are a closed set
// (ANALYTICS_EVENTS); props is a small JSON object with no PII. dedupeKey makes
// "first time" events (e.g. a kit's first outside view) idempotent.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  props     String?
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}

// Where a referrer wants to be paid. destination + taxId are encrypted (lib/token-crypto).
model PayoutProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method      String   // "paypal" | "wise" | "bank"
  destination String   // encrypted: PayPal/Wise email, or bank details text
  legalName   String
  country     String   // ISO-3166 alpha-2
  taxId       String?  // encrypted
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// One row per referred payment. amount is the referrer's commission in minor units of
// currency (the provider's settlement currency). "Available" = pending && availableAt <= now.
model ReferralCommission {
  id             String          @id @default(cuid())
  referrerId     String
  referrer       User            @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String
  referredUser   User            @relation("CommissionReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  paymentId      String          @unique
  baseAmount     Int             // pre-tax amount the referred user paid
  amount         Int             // commission
  currency       String
  status         String          @default("pending") // "pending" | "paid" | "reversed"
  availableAt    DateTime
  reversedAt     DateTime?
  payoutId       String?
  payout         ReferralPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([referrerId, status])
  @@index([referredUserId])
}

// One row per payment-provider webhook delivery (lib/webhook-log.ts). payload is our
// provider-agnostic domain event (ids + amounts, no emails), which is what an admin
// replay re-applies. Signature failures collapse into one row per provider per hour
// (deliveryId "rejected:<hour>") so an unauthenticated flood can't grow the table.
model WebhookEvent {
  id           String   @id @default(cuid())
  provider     String
  deliveryId   String?  // provider's delivery/event id; null when it didn't send one
  type         String   // domain event type, or "rejected"
  providerType String?  // provider's own event name, for ignored events
  status       String   // "processed" | "ignored" | "failed" | "rejected"
  error        String?
  payload      String?  // JSON domain event; null for ignored/rejected
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, deliveryId])
  @@index([status, createdAt])
  @@index([createdAt])
}

// Who changed what from the admin side (comps, plan resyncs, webhook replays).
// targetUserId is deliberately not a relation, so history survives account deletion.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actor        String   // admin email, or "script:<name>"
  action       String   // "comp.set" | "plan.resync" | "webhook.replay"
  targetUserId String?
  details      String?  // JSON { before, after, ... }
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

// A payment sent to a referrer (manually via PayPal/Wise/bank for now).
model ReferralPayout {
  id          String               @id @default(cuid())
  referrerId  String
  referrer    User                 @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  amount      Int
  currency    String
  method      String
  reference   String               // PayPal/Wise batch or transaction reference
  paidAt      DateTime             @default(now())
  commissions ReferralCommission[]

  @@index([referrerId])
}

/// Something a creator offers from their kit (lib/commerce.ts). Release A: free downloads
/// delivered by a creator-supplied link; paid checkout (creator-owned payments) comes next.
model Product {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("download") // "download" | "booking"
  bookingUrl  String?  // type "booking": the creator's Calendly / Cal.com / Google appointment link (public; embedded)
  title       String
  description String   @default("")
  coverUrl    String?  // base64 data URL, resized client-side like avatars
  priceCents  Int      @default(0) // 0 = free (email capture)
  currency    String   @default("USD")
  deliveryUrl String?  // revealed only on the buyer's private delivery page
  deliveryNote String  @default("")
  status      String   @default("draft") // "draft" | "published"
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([userId, status, position])
}

/// One claim or purchase of a product. Free claims are orders too (status "free"), so paid
/// sales reuse the same table. accessToken opens the buyer's private delivery page.
model Order {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerEmail  String
  buyerName   String?
  amountCents Int      @default(0)
  currency    String   @default("USD")
  status      String   @default("free") // "free" | "pending" | "paid" | "refunded"
  provider    String?  // payment provider, for paid orders
  providerOrderId String? // the provider's order/session id (Razorpay order_…), set at checkout
  providerRef String?  // the provider's payment id once paid
  accessToken String   @unique
  createdAt   DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([productId, buyerEmail])
}

/// A creator's own payment account (creator-owned payments: buyers pay the creator directly;
/// Kitevo never holds funds). One per provider. The secret is encrypted with lib/token-crypto.
model PaymentConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // "razorpay" (later: "stripe", "paypal")
  publicKey       String   // e.g. Razorpay key id (rzp_live_… / rzp_test_…); not secret
  secretEncrypted String   // encryptToken(key secret)
  livemode        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
}

/// A creator's own scheduling page (Calendly, Cal.com, Google Calendar appointment schedule),
/// connected once in Connectors and used by their booking products. The scheduler owns
/// availability, calendar conflicts, reminders and any payment. No secrets: links are public.
model SchedulerConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   // "calendly" | "calcom" | "google"
  url       String   // canonical public link (lib/scheduler-links parseSchedulerUrl)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

/// A brand deal agreed and paid through Kitevo. Money goes straight into the CREATOR's own
/// Razorpay / Stripe / PayPal (creator-owned payments; Kitevo never holds funds, 0% fee).
/// Transparency: every quote/offer is a DealVersion; accepting locks it; any change needs a
/// new version accepted by the other side; every step is a DealEvent both sides see.
model Deal {
  id           String   @id @default(cuid())
  creatorId    String
  creator      User     @relation("CreatorDeals", fields: [creatorId], references: [id], onDelete: Cascade)
  /// Brand with a Kitevo account (campaigns, messages). Null for kit-inquiry brands (email only).
  brandUserId  String?
  brandUser    User?    @relation("BrandDeals", fields: [brandUserId], references: [id], onDelete: SetNull)
  brandName    String
  brandEmail   String
  title        String
  /// "campaign" | "conversation" | "inquiry" | "direct"
  source       String   @default("direct")
  campaignApplicationId String?
  conversationId        String?
  inquiryId             String?
  /// "proposed" (a version awaits a reply) | "accepted" | "delivered" | "completed" | "declined" | "cancelled"
  status       String   @default("proposed")
  /// Private link for brands without an account (/d/<token>); also works for account brands.
  brandToken   String   @unique
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions DealVersion[]
  payments DealPayment[]
  events   DealEvent[]

  @@index([creatorId, updatedAt])
  @@index([brandUserId, updatedAt])
}

model DealVersion {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  number       Int
  /// "creator" | "brand"
  proposedBy   String
  /// [{ label, quantity }]
  deliverables Json
  amountCents  Int
  currency     String
  /// 0 = full payment upfront on acceptance; 1–99 = that % on acceptance, the rest on delivery;
  /// 100 is not used (full upfront is 0's "upfront" mode); see lib/deals-shared splitPlan.
  advancePct   Int      @default(0)
  /// "upfront" | "split" | "on_delivery"
  paymentPlan  String   @default("upfront")
  dueDate      DateTime?
  notes        String   @default("")
  /// "open" | "accepted" | "declined" | "superseded" | "withdrawn"
  status       String   @default("open")
  respondedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([dealId, number])
}

model DealPayment {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// "full" | "advance" | "balance"
  kind            String
  amountCents     Int
  currency        String
  /// "scheduled" (not payable yet: balance before delivery) | "due" | "pending" (checkout started) | "paid"
  status          String   @default("scheduled")
  provider        String?
  providerOrderId String?
  providerRef     String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dealId])
}

model DealEvent {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// "creator" | "brand" | "system"
  actor     String
  /// proposed | countered | accepted | declined | withdrawn | cancelled | payment_due | paid | delivered | completed
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}


/// A creator's own AI provider key for Copilot (Connectors → AI). One per user; connecting
/// another provider replaces it. The key is encrypted with lib/token-crypto and never sent
/// back to a client (only `keyHint`). When present, Copilot runs on it with no Kitevo cap.
model AiConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // lib/ai/providers AI_PROVIDERS: groq | openrouter | openai | gemini | anthropic
  keyEncrypted String   // encryptToken(api key)
  keyHint      String   // e.g. "gsk_…AbCd"
  model        String?  // null = the provider's default model
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One Copilot generation. `source` "kitevo" counts against the monthly cap on Kitevo's own
/// key; "own" (the creator's key) is recorded for analytics only. No prompt or output text.
model CopilotUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      String   // bio | pitch | inquiry_reply
  source    String   // kitevo | own
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One account blocking another (lib/safety.ts). Either direction stops new messages, new
/// conversations, campaign applications and new deals or deal terms between the two;
/// existing threads and deals stay readable, and payments/delivery on a deal still work.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A creator blocking a kit-inquiry sender (no account, so by email). Later inquiries from
/// that email are accepted silently and dropped (the sender isn't told).
model InquiryBlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   // lowercased
  createdAt DateTime @default(now())

  @@unique([userId, email])
}

/// A report of another account, reviewed in /admin/reports.
model UserReport {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User      @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String    // lib/safety REPORT_REASONS
  note       String?   // ≤ 1000 chars, reporter's words
  context    String?   // where it was reported from: "conversation:<id>" | "deal:<id>" | "campaign:<id>" | "application:<id>" | "profile"
  status     String    @default("open") // open | dismissed | actioned
  resolvedBy String?   // admin email
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([reportedId])
  @@index([reporterId]) // FK: deleting an account removes reports it filed
}
