// Prisma schema — Phase 6 (auth) and beyond (profile, kits, subscription)
// PostgreSQL (Neon, Vercel Postgres, or local Postgres). For local dev use a Postgres URL or Neon branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?  // null if OAuth-only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 9: link Stripe customer
  stripeCustomerId String? @unique

  // Phase 7: creator profile (can move to separate table later)
  username  String?  @unique // for /kit/[username] and profile URL
  bio       String?
  avatarUrl String?
  links     String?  // JSON array of { label, url }

  // Phase 10: Instagram (Meta Graph API)
  instagramUserId           String?   // IG Business/Creator account id
  instagramAccessToken      String?   // Long-lived token for API calls
  instagramTokenExpiresAt   DateTime? // When token expires (for refresh prompt)

  // Phase 11: Onboarding (redirect new users to /onboarding until they finish)
  onboardingCompletedAt DateTime?

  // Email verification
  emailVerified             Boolean   @default(false)
  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiresAt DateTime?

  // Password reset
  resetPasswordToken          String?   @unique
  resetPasswordTokenExpiresAt DateTime?

  // OAuth accounts (Google etc.)
  accounts Account[]

  // Relations for Phase 8 (kits)
  kits      Kit[]
}


model Kit {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String   // unique per user (userId_slug); use findFirst for global slug lookup
  name              String
  workSamples       String   // JSON
  rates             String   // JSON
  brands            String   // JSON
  sectionVisibility String   // JSON
  appearance        String   @default("{}") // kit theme JSON: { preset: warm|cool|paper|noir }
  passwordHash      String?  // bcrypt hash; null = public kit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])

  // Phase 12.3: Kit analytics (views)
  views     KitView[]
  inquiries Inquiry[]
}

model KitView {
  id       String   @id @default(cuid())
  kitId    String
  kit      Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  referrer String?

  @@index([kitId])
  @@index([viewedAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  status    String   @default("new") // new | reviewing | negotiating | won | lost

  @@index([kitId])
  @@index([createdAt])
}

// OAuth accounts (Google, etc.) linked to a User
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String  // "google"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  @@unique([provider, providerAccountId])
  @@index([userId])
}
